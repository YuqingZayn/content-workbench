{
  "name": "content-workbench",
  "version": "0.1.0",
  "description": "本地优先的账号项目内容工作台",
  "private": true,
  "type": "module",
  "author": "YuqingZayn",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --ignore-pattern src/services/codex/generated",
    "test": "tsx --test tests/domain.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:e2e": "npm run build && playwright test",
    "verify:codex": "tsx scripts/verify-codex.ts",
    "verify:first-loop": "tsx scripts/verify-first-loop.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "dist:win": "node scripts/ensure-runtime.mjs && npm run build && node scripts/dist-win.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.yuqingzayn.contentworkbench",
    "electronDist": "node_modules/electron/dist",
    "productName": "Content Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Content-Workbench-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Content-Workbench-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "Content-Workbench-${version}-${arch}.${ext}"
  }
}
